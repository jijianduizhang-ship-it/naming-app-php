# 瑞名阁智能起名系统 - 环境变量配置示例
# 复制此文件为 .env 后填入真实值

# ==================== 数据库 ====================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=name_imoons_cn
DB_USER=name_imoons_cn
DB_PASSWORD=your_db_password_here

# ==================== AI（DeepSeek）====================
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=sk-your-deepseek-api-key
AI_MODEL=deepseek-chat

# ==================== JWT 密钥 ====================
JWT_SECRET=your_jwt_secret_random_string_min_32_chars
