.container {
  padding-bottom: 40rpx;
}

.hero-section {
  padding: 60rpx 0 50rpx;
}

.hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-text {
  font-family: 'Ma Shan Zheng', cursive;
  font-size: 84rpx;
  background: linear-gradient(135deg, #C41E3A, #E8837C);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 15rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #8B6F63;
  margin-bottom: 45rpx;
}

.btn-lg {
  width: 400rpx;
  height: 100rpx;
  line-height: 100rpx;
}

.features-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #534138;
  text-align: center;
  margin-bottom: 30rpx;
}

.features-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.feature-card {
  background: white;
  border-radius: 28rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 32rpx rgba(139, 26, 26, 0.08);
}

.feature-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #534138;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #8B6F63;
  text-align: center;
}

.quick-links {
  display: flex;
  gap: 24rpx;
}

.link-card {
  flex: 1;
  background: white;
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 32rpx rgba(139, 26, 26, 0.08);
  display: flex;
  flex-direction: column;
}

.link-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #534138;
  margin-bottom: 8rpx;
}

.link-desc {
  font-size: 24rpx;
  color: #8B6F63;
}
