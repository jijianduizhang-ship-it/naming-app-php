.container {
  padding: 30rpx;
  padding-bottom: 120rpx;
}

.result-header {
  text-align: center;
  padding: 40rpx 0 50rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #534138;
  margin-bottom: 15rpx;
  display: block;
}

.result-subtitle {
  font-size: 26rpx;
  color: #8B6F63;
  display: block;
}

.name-card {
  background: white;
  border-radius: 28rpx;
  padding: 35rpx;
  box-shadow: 0 4rpx 32rpx rgba(139, 26, 26, 0.08);
  transition: transform 0.2s, box-shadow 0.2s;
}

.name-header {
  margin-bottom: 20rpx;
}

.name-text {
  font-size: 44rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #C41E3A, #E8837C);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.name-pinyin {
  font-size: 26rpx;
  color: #8B6F63;
}

.score-badge {
  background: linear-gradient(135deg, #C41E3A, #E8837C);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: baseline;
  gap: 5rpx;
}

.score-text {
  font-size: 32rpx;
  font-weight: 700;
}

.score-label {
  font-size: 20rpx;
}

.name-meaning {
  font-size: 28rpx;
  color: #534138;
  margin-bottom: 20rpx;
  display: block;
}

.name-tags {
  display: flex;
}

.tag {
  background: #FFF5F5;
  color: #C41E3A;
  padding: 10rpx 25rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.btn-outline {
  border: 2rpx solid #C41E3A;
  color: #C41E3A;
  background: white;
  border-radius: 28rpx;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
}
