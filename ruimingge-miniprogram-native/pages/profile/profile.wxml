<view class="container">
  <view class="profile-header">
    <view class="avatar">👤</view>
    <text class="username">起名用户</text>
  </view>

  <view class="credits-card card">
    <view class="credits-info">
      <text class="credits-label">剩余起名次数</text>
      <view class="credits-display">
        <text class="credits-amount">{{credits}}</text>
        <text class="credits-unit">次</text>
      </view>
    </view>
    <button class="btn-primary btn-sm" bindtap="goToRedeem">
      兑换次数
    </button>
  </view>

  <view class="menu-list space-y-3 mt-4">
    <view class="menu-item" bindtap="goToKnowledge">
      <view class="menu-icon">📚</view>
      <text class="menu-text">起名知识</text>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-icon">ℹ️</view>
      <text class="menu-text">关于我们</text>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="contactUs">
      <view class="menu-icon">📧</view>
      <text class="menu-text">联系我们</text>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>
