.container {
  padding: 30rpx;
}

.header {
  padding: 60rpx 0 50rpx;
}

.logo {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-family: 'Ma Shan Zheng', cursive;
  font-size: 48rpx;
  background: linear-gradient(135deg, #C41E3A, #E8837C);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 12rpx;
  display: block;
}

.app-version {
  font-size: 24rpx;
  color: #A8988C;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #534138;
  margin-bottom: 20rpx;
  display: block;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #6B5A50;
}

.feature-list {
  display: flex;
  flex-direction: column;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}

.feature-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #534138;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #8B6F63;
}

.contact-list {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0E8E0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 26rpx;
  color: #8B6F63;
}

.contact-value {
  font-size: 26rpx;
  color: #534138;
}
