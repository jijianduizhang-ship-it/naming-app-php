.container {
  padding: 30rpx;
}

.credits-display {
  padding: 30rpx;
  background: linear-gradient(135deg, #FFF5F5, #FFE8E8);
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.credits-label {
  font-size: 28rpx;
  color: #8B6F63;
}

.credits-amount {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #C41E3A, #E8837C);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.credits-text {
  font-size: 28rpx;
  color: #C41E3A;
}

.btn-link {
  color: #C41E3A;
  font-size: 26rpx;
  font-weight: 500;
}

.form-section {
  background: white;
  border-radius: 28rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 32rpx rgba(139, 26, 26, 0.08);
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #534138;
  margin-bottom: 15rpx;
  display: block;
}

.required {
  color: #C41E3A;
}

.form-input {
  width: 100%;
  background: #F8F4F0;
  border: 2rpx solid #E6DDD4;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.picker-input {
  color: #534138;
}

.gender-select {
  display: flex;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.gender-option {
  flex: 1;
  padding: 30rpx;
  border: 3rpx solid #E6DDD4;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  cursor: pointer;
  transition: all 0.2s;
  background: #F8F4F0;
}

.gender-option.active {
  border-color: #C41E3A;
  background: #FFF5F5;
}

.gender-icon {
  font-size: 48rpx;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  background: #F8F4F0;
  border: 2rpx solid #E6DDD4;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.btn-full {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
}
