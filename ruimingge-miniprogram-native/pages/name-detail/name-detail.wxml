<view class="container" wx:if="{{name}}">
  <view class="detail-header">
    <view class="header-main text-center">
      <text class="detail-name">{{name.name}}</text>
      <text class="detail-pinyin">{{name.pinyin}}</text>
      <view class="score-display mt-4">
        <text class="score-number">{{name.score}}</text>
        <text class="score-unit">分</text>
      </view>
      <text class="score-label">综合评分</text>
    </view>
    <view class="favorite-btn" bindtap="toggleFavorite">
      {{name.favorite ? '❤️' : '🤍'}}
    </view>
  </view>

  <view class="detail-content space-y-4">
    <view class="card">
      <text class="section-title">名字寓意</text>
      <text class="meaning-text">{{name.meaning}}</text>
    </view>

    <view class="card">
      <text class="section-title">详细解析</text>
      <text class="analysis-text">{{name.analysis}}</text>
    </view>

    <view class="card">
      <text class="section-title">五行笔画</text>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">五行</text>
          <text class="info-value">{{name.wuxing}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">笔画</text>
          <text class="info-value">{{name.strokes}}画</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{name.poems && name.poems.length > 0}}">
      <text class="section-title">诗词出处</text>
      <view class="poem-list space-y-3">
        <view class="poem-item" wx:for="{{name.poems}}" wx:key="index">
          <text>{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
